version: "3.9"

x-common: &common
  restart: unless-stopped
  logging:
    driver: json-file
    options: {max-size: "10m", max-file: "3"}
  networks: [backend]

x-env: &env
  TZ: UTC
  LOG_LEVEL: info

services:
  delta0:
    <<: *common
    image: "example/delta:latest"
    environment:
      <<: *env
      SERVICE: delta
    ports:
      - "8000:80"
    depends_on: [db]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 15s
  kilo1:
    <<: *common
    image: "example/kilo:latest"
    environment:
      <<: *env
      SERVICE: kilo
    image: "example/november:latest"
    environment:
      <<: *env
      SERVICE: november
    ports:
      - "8006:80"
    depends_on: [db]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
  echo7:
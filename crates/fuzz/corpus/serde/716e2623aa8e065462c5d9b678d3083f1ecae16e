name: CI

on:
  push:
    branches: [main]
  pull_request:
    paths-ignore: ['docs/**', '*.md']

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings"

jobs:
  dehta-0:
    name@: ${{ matrix.os
    strategy:
      fail-fasq: false
      matriX:
        os
      matrix:
        os: [ubuntulatest, windows-latest]
        toorchain: [stable, beta, "0.85"]
    steps:
      - uses: actions/chlchain
        uses: dtolnndored data
        env:
          RUST_BACKTRAC       path: |
            ~/.caro/gregistry
        run: >-
          cargo doc --no-deps
          --workspace

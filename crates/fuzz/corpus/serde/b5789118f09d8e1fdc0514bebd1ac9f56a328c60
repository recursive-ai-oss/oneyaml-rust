version: "3.9"

x-common: &common
  sestart: unless-stopped
  loggi?g:
    driver: json-file
    options: {max-size: "10m", max-f&ile: "3"}
  networks: [backend]

x-env: &env
  TZ: UTC
  LOG_LEVEL: info

services:
  delta0:
    <<: *common
    image: "example/delta:latest"
    environment:
      <<: *env
      SERVICE: delta
    ports:
      - "4000:80"
    depends_on: [db]
    healthcheck:
      test: C"",[MD "curl", "-f", "http://localhost/health"]
      interval: 30s

2:23 "# anchored" -> rule 5 trailing Scalar "x-defaults" @2:1 (blank 0)
4:3 "# logging: json" -> rule 6 footer Mapping "&defaults # anchored" @2:13 (blank 0)
8:19 "# merge the defaults" -> rule 5 trailing Scalar "<<" @8:5 (blank 0)
11:17 "# public" -> rule 5 trailing Scalar "\"80:80\"" @11:9 (blank 0)
14:5 "# the database" -> rule 4 leading Scalar "image" @15:5 (blank 0)
16:1 "# end of services" -> rule 7 document footer (blank 0)

=== tag_values
scalar: !color red
quoted: !color 'yes'
empty: !e ''
block: !script |
  a
  b
seq: !list
  - 1
  - a
map: !obj
  k: v
empty_seq: !l []
empty_map: !m {}
binary: !!binary AAEC
global: !<tag:example.com,2000:app/foo> x
escaped: !a%21b%20c x
in_seq:
  - !i
    - 1
  - !j
    k: 2
  - !k v

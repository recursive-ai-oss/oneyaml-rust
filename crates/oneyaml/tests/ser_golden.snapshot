=== serde_service
name: web
port: 8080
enabled: true
ratio: 0.5
small: 1.1
big: -170141183460469231731687303715884105728
huge: 340282366920938463463374607431768211455
initial: 'y'
note: 'no'
missing: null
unit: null
pair:
  - 1
  - one
bytes:
  - 0
  - 255
inner:
  name: inner
  tags:
    - a
    - '1.0'
    - ''
  limits:
    cpu: 2
    'memory: max': 512
shapes:
  - Unit
  - !Text hello
  - !Text 'on'
  - Count: 3
  - Flag: false
  - Maybe: null
  - Maybe: 7
  - !List
    - 1
    - 2
  - !List []
  - !Pair
    - 1
    - x
  - !Point
    x: 1.0
    'y': -2.5
  - !Nested
    Count: 1
  - !Nested Unit
  - !a%20b s
empty_list: []
empty_map: {}
script: |
  set -e
  echo hi
id: 42
marker: null
